# Postgres connection string (Supabase, Neon, Railway, or any hosted Postgres)
DATABASE_URL=postgresql://user:password@host:5432/dbname

# NextAuth
NEXTAUTH_SECRET=generate-with-openssl-rand-base64-32
NEXTAUTH_URL=http://localhost:3000

# Admin login — password is stored as a bcrypt hash, never plaintext.
# Generate the hash with: node -e "console.log(require('bcryptjs').hashSync('yourpassword', 10))"
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD_HASH=replace-with-a-bcrypt-hash
